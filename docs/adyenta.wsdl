<?xml version="1.0" encoding="UTF-8"?>
<!--
  Adyenta Payment Service v12 (Sandbox) — WSDL contract for the build challenge.
  The prose version of this spec is ADYENTA.md; where they disagree, ADYENTA.md wins.

  You do NOT need a WSDL toolchain to integrate — hand-templating the XML envelopes
  is acceptable and expected. This file exists so the vendor docs feel real and so
  code-generation tooling works if you choose to use it.

  Reminders that a WSDL cannot express:
  - Amount values are decimal strings in MAJOR units ("10.50"); currencies are
    uppercase ISO 4217 (USD, EUR only).
  - Cards must be tokenized via CreateCardToken first; AuthoriseAndCapture accepts
    only Adyenta tokens (ADYC-...). Any other value is a Fault [702].
  - Idempotency is NOT supported: every accepted AuthoriseAndCapture request creates
    a new, distinct transaction, including identical retries.
  - Both AUTHORISED and REFUSED return HTTP 200; only system errors are SOAP Faults
    (HTTP 500). Fault codes: [010] auth failure, [702] validation, [905] internal.
  - refusalCode values: 51 Not enough balance (soft), 43 Stolen card (hard),
    05 Do not honour (soft).
  - Sandbox test cards (behavior triggers at charge time, keyed off the number
    used in CreateCardToken): 4242424242424242 AUTHORISED; 4000000000009995
    REFUSED/51; 4000000000009979 REFUSED/43; 4000000000000119 Fault [905];
    4000000000005900 30s delay then Fault [905].
-->
<wsdl:definitions name="AdyentaPaymentService"
    targetNamespace="http://payment.adyenta.com/v12"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:pay="http://payment.adyenta.com/v12">

  <wsdl:types>
    <xsd:schema targetNamespace="http://payment.adyenta.com/v12"
        elementFormDefault="qualified">

      <xsd:complexType name="Amount">
        <xsd:sequence>
          <!-- Decimal string in MAJOR units, e.g. "10.50" -->
          <xsd:element name="value" type="xsd:decimal"/>
          <!-- Uppercase ISO 4217; sandbox supports USD and EUR -->
          <xsd:element name="currency" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:simpleType name="ResultCode">
        <xsd:restriction base="xsd:string">
          <xsd:enumeration value="AUTHORISED"/>
          <xsd:enumeration value="REFUSED"/>
          <xsd:enumeration value="REFUNDED"/>
        </xsd:restriction>
      </xsd:simpleType>

      <!-- SOAP header: credentials on every request -->
      <xsd:element name="Security">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="Username" type="xsd:string"/>
            <xsd:element name="Password" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:complexType name="Card">
        <xsd:sequence>
          <xsd:element name="number" type="xsd:string"/>
          <xsd:element name="expiryMonth" type="xsd:string"/>
          <xsd:element name="expiryYear" type="xsd:string"/>
          <xsd:element name="cvc" type="xsd:string"/>
        </xsd:sequence>
      </xsd:complexType>

      <xsd:element name="CreateCardTokenRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="merchantAccount" type="xsd:string"/>
            <xsd:element name="card" type="pay:Card"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="CreateCardTokenResponse">
        <xsd:complexType>
          <xsd:sequence>
            <!-- Adyenta card token, e.g. ADYC-8841-2296-0034. Reusable in sandbox. -->
            <xsd:element name="cardToken" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="AuthoriseAndCaptureRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="merchantAccount" type="xsd:string"/>
            <xsd:element name="merchantReference" type="xsd:string"/>
            <xsd:element name="amount" type="pay:Amount"/>
            <xsd:element name="cardToken" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="AuthoriseAndCaptureResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="pspReference" type="xsd:string"/>
            <xsd:element name="resultCode" type="pay:ResultCode"/>
            <!-- Present when AUTHORISED. Format: DD/MM/YYYY HH:mm:ss z -->
            <xsd:element name="processedAt" type="xsd:string" minOccurs="0"/>
            <!-- Present when REFUSED -->
            <xsd:element name="refusalCode" type="xsd:string" minOccurs="0"/>
            <xsd:element name="refusalReason" type="xsd:string" minOccurs="0"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="RefundTransactionRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="merchantAccount" type="xsd:string"/>
            <xsd:element name="originalPspReference" type="xsd:string"/>
            <!-- Required: Adyenta does not infer full refunds -->
            <xsd:element name="amount" type="pay:Amount"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="RefundTransactionResponse">
        <xsd:complexType>
          <xsd:sequence>
            <!-- A NEW pspReference for the refund itself -->
            <xsd:element name="pspReference" type="xsd:string"/>
            <xsd:element name="resultCode" type="pay:ResultCode"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="GetTransactionStatusRequest">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="pspReference" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

      <xsd:element name="GetTransactionStatusResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="pspReference" type="xsd:string"/>
            <xsd:element name="resultCode" type="pay:ResultCode"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>

    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="SecurityHeader">
    <wsdl:part name="Security" element="pay:Security"/>
  </wsdl:message>
  <wsdl:message name="CreateCardTokenInput">
    <wsdl:part name="body" element="pay:CreateCardTokenRequest"/>
  </wsdl:message>
  <wsdl:message name="CreateCardTokenOutput">
    <wsdl:part name="body" element="pay:CreateCardTokenResponse"/>
  </wsdl:message>
  <wsdl:message name="AuthoriseAndCaptureInput">
    <wsdl:part name="body" element="pay:AuthoriseAndCaptureRequest"/>
  </wsdl:message>
  <wsdl:message name="AuthoriseAndCaptureOutput">
    <wsdl:part name="body" element="pay:AuthoriseAndCaptureResponse"/>
  </wsdl:message>
  <wsdl:message name="RefundTransactionInput">
    <wsdl:part name="body" element="pay:RefundTransactionRequest"/>
  </wsdl:message>
  <wsdl:message name="RefundTransactionOutput">
    <wsdl:part name="body" element="pay:RefundTransactionResponse"/>
  </wsdl:message>
  <wsdl:message name="GetTransactionStatusInput">
    <wsdl:part name="body" element="pay:GetTransactionStatusRequest"/>
  </wsdl:message>
  <wsdl:message name="GetTransactionStatusOutput">
    <wsdl:part name="body" element="pay:GetTransactionStatusResponse"/>
  </wsdl:message>

  <wsdl:portType name="PaymentPortType">
    <wsdl:operation name="CreateCardToken">
      <wsdl:input message="pay:CreateCardTokenInput"/>
      <wsdl:output message="pay:CreateCardTokenOutput"/>
    </wsdl:operation>
    <wsdl:operation name="AuthoriseAndCapture">
      <wsdl:input message="pay:AuthoriseAndCaptureInput"/>
      <wsdl:output message="pay:AuthoriseAndCaptureOutput"/>
    </wsdl:operation>
    <wsdl:operation name="RefundTransaction">
      <wsdl:input message="pay:RefundTransactionInput"/>
      <wsdl:output message="pay:RefundTransactionOutput"/>
    </wsdl:operation>
    <wsdl:operation name="GetTransactionStatus">
      <wsdl:input message="pay:GetTransactionStatusInput"/>
      <wsdl:output message="pay:GetTransactionStatusOutput"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="PaymentBinding" type="pay:PaymentPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="CreateCardToken">
      <soap:operation soapAction="CreateCardToken"/>
      <wsdl:input>
        <soap:header message="pay:SecurityHeader" part="Security" use="literal"/>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="AuthoriseAndCapture">
      <soap:operation soapAction="AuthoriseAndCapture"/>
      <wsdl:input>
        <soap:header message="pay:SecurityHeader" part="Security" use="literal"/>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="RefundTransaction">
      <soap:operation soapAction="RefundTransaction"/>
      <wsdl:input>
        <soap:header message="pay:SecurityHeader" part="Security" use="literal"/>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="GetTransactionStatus">
      <soap:operation soapAction="GetTransactionStatus"/>
      <wsdl:input>
        <soap:header message="pay:SecurityHeader" part="Security" use="literal"/>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="AdyentaPaymentService">
    <wsdl:port name="PaymentPort" binding="pay:PaymentBinding">
      <!-- Sandbox is fictional — point your client at your local mock instead,
           e.g. http://localhost:4002/soap/Payment/v12 -->
      <soap:address location="https://pal.adyenta.test/soap/Payment/v12"/>
    </wsdl:port>
  </wsdl:service>

</wsdl:definitions>
